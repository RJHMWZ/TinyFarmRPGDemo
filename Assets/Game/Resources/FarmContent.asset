  recipes:
  - id: fertilizer
    title: Fertilizer
    outputId: fertilizer
    outputCount: 2
    requiredLevel: 1
    ingredients:
    - itemId: wood
      count: 3
    - itemId: stone
      count: 2
  - id: salad
    title: Farm Salad
    outputId: salad
    outputCount: 1
    requiredLevel: 1
    ingredients:
    - itemId: parsnip
      count: 1
    - itemId: berry
      count: 2
  - id: sprinkler
    title: Sprinkler
    outputId: sprinkler
    outputCount: 1
    requiredLevel: 2
    ingredients:
    - itemId: wood
      count: 10
    - itemId: stone
      count: 10
  - id: seed-pouch
    title: Carrot Seed Pouch
    outputId: carrot-seed
    outputCount: 3
    requiredLevel: 2
    ingredients:
    - itemId: carrot
      count: 1
    - itemId: wood
      count: 2
  quests:
  - id: first-soil
    title: A Fresh Start
    description: Till five plots with your hoe.
    prerequisite: 
    counter: till
    target: 5
    goldReward: 80
    experienceReward: 20
  - id: first-seeds
    title: Seeds of Tomorrow
    description: Plant five seeds.
    prerequisite: first-soil
    counter: plant
    target: 5
    goldReward: 100
    experienceReward: 20
  - id: first-water
    title: A Little Care
    description: Water five plots.
    prerequisite: first-seeds
    counter: water
    target: 5
    goldReward: 60
    experienceReward: 20
  - id: neighbors
    title: Meet the Neighbors
    description: Talk to villagers on three occasions.
    prerequisite: 
    counter: talk
    target: 3
    goldReward: 90
    experienceReward: 30
  - id: gatherer
    title: Gather the Basics
    description: Gather from five resource nodes.
    prerequisite: 
    counter: gather
    target: 5
    goldReward: 100
    experienceReward: 40
  - id: first-harvest
    title: First Harvest
    description: Harvest five crops.
    prerequisite: first-water
    counter: harvest
    target: 5
    goldReward: 150
    experienceReward: 50
  - id: first-shipping
    title: From Farm to Market
    description: Ship five items using the shipping bin.
    prerequisite: first-harvest
    counter: ship
    target: 5
    goldReward: 120
    experienceReward: 40
  - id: maker
    title: Made by Hand
    description: Craft three items.
    prerequisite: gatherer
    counter: craft
    target: 3
    goldReward: 150
    experienceReward: 50
  - id: friend
    title: A Thoughtful Gift
    description: Give three gifts to your neighbors.
    prerequisite: neighbors
    counter: gift
    target: 3
    goldReward: 120
    experienceReward: 40
  - id: prosperity
    title: Growing Together
    description: Earn 1000 gold from shipping.
    prerequisite: first-shipping
    counter: earn
    target: 1000
    goldReward: 300
    experienceReward: 100
  villagers:
  - id: willow
    title: Willow
    favoriteItem: parsnip
    dialogue:
    - Welcome! Start with a few watered plots. A small farm can do great things.
    - Leave room in your backpack before harvesting. Your crops can wait safely.
    - Rain is a farmer's best helper. Use the extra time to gather materials.
    portrait: {fileID: 0}
    layers:
    - {fileID: -4921510441440489021}
    - {fileID: -8756461286671859886}
    - {fileID: 1268600633940218485}
    - {fileID: 5687511619152217295}
  - id: rowan
    title: Rowan
    favoriteItem: berry
    dialogue:
    - Wood and stone regrow in two days around here. Take only what you need.
    - A sprinkler waters its own plot and the four plots around it each morning.
    - Gifts are lovely, but a friendly conversation matters just as much.
    portrait: {fileID: 0}
    layers:
    - {fileID: 3430542140596343201}
    - {fileID: 1966835285874466613}
    - {fileID: 382001211279464180}
    - {fileID: -4968207879133300645}
  secondsPerTenMinutes: 7
  dayEndHour: 22
